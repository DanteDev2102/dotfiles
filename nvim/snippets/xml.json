{
  "Odoo Record": {
    "prefix": "orec",
    "body": [
      "<record id=\"${1:id}\" model=\"${2:model}\">",
      "\t${0}",
      "</record>"
    ],
    "description": "Generic Record Block"
  },
  "View Form": {
    "prefix": "oform",
    "body": [
      "<record id=\"view_${1:model_name}_form\" model=\"ir.ui.view\">",
      "\t<field name=\"name\">${1:model.name}.form</field>",
      "\t<field name=\"model\">${2:model.name}</field>",
      "\t<field name=\"arch\" type=\"xml\">",
      "\t\t<form>",
      "\t\t\t<sheet>",
      "\t\t\t\t<group>",
      "\t\t\t\t\t<group>",
      "\t\t\t\t\t\t<field name=\"${3:name}\"/>",
      "\t\t\t\t\t</group>",
      "\t\t\t\t</group>",
      "\t\t\t\t${0}",
      "\t\t\t</sheet>",
      "\t\t</form>",
      "\t</field>",
      "</record>"
    ],
    "description": "Form View"
  },
  "View List": {
    "prefix": "olist",
    "body": [
      "<record id=\"view_${1:model_name}_tree\" model=\"ir.ui.view\">",
      "\t<field name=\"name\">${1:model.name}.list</field>",
      "\t<field name=\"model\">${2:model.name}</field>",
      "\t<field name=\"arch\" type=\"xml\">",
      "\t\t<list>",
      "\t\t\t<field name=\"${3:name}\"/>",
      "\t\t\t${0}",
      "\t\t</list>",
      "\t</field>",
      "</record>"
    ],
    "description": "List View"
  },
  "View Search": {
    "prefix": "osearch",
    "body": [
      "<record id=\"view_${1:model_name}_search\" model=\"ir.ui.view\">",
      "\t<field name=\"name\">${1:model.name}.search</field>",
      "\t<field name=\"model\">${2:model.name}</field>",
      "\t<field name=\"arch\" type=\"xml\">",
      "\t\t<search>",
      "\t\t\t<field name=\"${3:name}\"/>",
      "\t\t\t<filter string=\"${4:My Filter}\" name=\"${5:filter_name}\" domain=\"[('${6:field}', '=', '${7:value}')]\"/>",
      "\t\t\t<group expand=\"1\" string=\"Group By\">",
      "\t\t\t\t<filter string=\"${8:Group Name}\" name=\"${9:group_name}\" context=\"{'group_by':'${10:field}'}\"/>",
      "\t\t\t</group>",
      "\t\t</search>",
      "\t</field>",
      "</record>"
    ],
    "description": "Search View with Filters"
  },
  "Action Window": {
    "prefix": "oaction",
    "body": [
      "<record id=\"action_${1:model_name}\" model=\"ir.actions.act_window\">",
      "\t<field name=\"name\">${2:Action Name}</field>",
      "\t<field name=\"res_model\">${3:model.name}</field>",
      "\t<field name=\"view_mode\">tree,form</field>",
      "\t<field name=\"help\" type=\"html\">",
      "\t\t<p class=\"o_view_nocontent_smiling_face\">",
      "\t\t\tCreate a new record",
      "\t\t</p>",
      "\t</field>",
      "</record>"
    ],
    "description": "Window Action"
  },
  "Menu Item": {
    "prefix": "omenu",
    "body": "<menuitem id=\"menu_${1:id}\" name=\"${2:Name}\" parent=\"${3:parent_menu_id}\" action=\"action_${4:action_id}\" sequence=\"${5:10}\"/>",
    "description": "Menu Item"
  },
  "XPath Inherit": {
    "prefix": "oxpath",
    "body": [
      "<record id=\"view_${1:model}_form_inherit\" model=\"ir.ui.view\">",
      "\t<field name=\"name\">${2:model.name}.inherit</field>",
      "\t<field name=\"model\">${2:model.name}</field>",
      "\t<field name=\"inherit_id\" ref=\"${3:module.original_view_id}\"/>",
      "\t<field name=\"arch\" type=\"xml\">",
      "\t\t<xpath expr=\"//field[@name='${4:target_field}']\" position=\"${5:after}\">",
      "\t\t\t<field name=\"${6:new_field}\"/>",
      "\t\t</xpath>",
      "\t</field>",
      "</record>"
    ],
    "description": "XPath Inheritance"
  }
}
